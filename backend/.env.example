FRED_API_KEY=your_fred_api_key
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
ADMIN_PASSWORD=choose_a_long_admin_password
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
SUPPORT_EMAIL=support@hustix.com
# Resend from localhost: set SMTP_HOST (backend + restart API/admin). SMTP_USER is always
# "resend"; SMTP_PASSWORD is your Resend API key (re_...). SMTP_FROM must be a verified
# sender in Resend (e.g. support@yourdomain.com). Until the domain is verified, Resend
# only allows sending to your own address via onboarding@resend.dev as From.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=re_your_resend_api_key
# SMTP_FROM=support@hustix.com
# APP_URL=http://127.0.0.1:3000
