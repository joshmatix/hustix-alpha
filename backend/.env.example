FRED_API_KEY=your_fred_api_key
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
ADMIN_PASSWORD=choose_a_long_admin_password
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
SUPPORT_EMAIL=support@hustix.com
# Leave SMTP_HOST empty locally to use the Supabase mail catcher (Mailpit).
# Production (Resend SMTP): SMTP_USER is always "resend"; password is your re_ API key.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=re_your_resend_api_key
# SMTP_FROM=support@hustix.com
